{
  "name": "escape-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Escape — веб-сайт (корінь) + React Native додаток (apps/mobile)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "mobile:start": "npm run start --workspace=EscapeMobile",
    "mobile:ios": "npm run ios --workspace=EscapeMobile",
    "mobile:android": "npm run android --workspace=EscapeMobile",
    "mobile:lint": "npm run lint --workspace=EscapeMobile",
    "mobile:pod-install": "cd apps/mobile/ios && bundle exec pod install"
  },
  "engines": {
    "node": ">=20"
  }
}
